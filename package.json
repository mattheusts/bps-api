{
  "name": "bps-app",
  "version": "1.0.0",
  "description": "Banco de Preços em Saúde - CRUD e dashboards (NestJS + MySQL, sem ORM)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node --env-file=.env dist/main.js",
    "db:criar": "node --env-file=.env dist/scripts/criar-banco.js",
    "criar-admin": "node --env-file=.env dist/scripts/criar-admin.js",
    "importar": "node --env-file=.env dist/scripts/importar.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "mysql2": "^3.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
